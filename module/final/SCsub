#!/usr/bin/env python
"""
MCP Editor Module — SCons 构建脚本
告诉 SCons 需要编译哪些源文件，以及 include 路径。
"""
Import("env")
Import("env_modules")

# 克隆模块构建环境
env_mcp_editor = env_modules.Clone()

# 添加模块自身的 include 路径
env_mcp_editor.Prepend(
    CPPPATH=["#modules/mcp_editor"],
)

# ---- 收集所有源文件 ----
module_obj = []

# 模块注册（Godot 要求文件名包含 .gen.）
module_obj.append(env_mcp_editor.Object("register_types.gen.cpp", "register_types.cpp"))

# ---- 核心类 ----
core_sources = [
    "core/mcp_command_queue.cpp",
    "core/mcp_sandbox.cpp",
    "core/mcp_event_bus.cpp",
    "core/mcp_websocket_server.cpp",
    "core/mcp_snapshot.cpp",
]
for src in core_sources:
    module_obj.append(env_mcp_editor.Object(src))

# ---- 工具实现 ----
tool_sources = [
    "tools/scene_tools.cpp",
    "tools/node_tools.cpp",
    "tools/script_tools.cpp",
    "tools/file_tools.cpp",
    "tools/play_tools.cpp",
    "tools/diagnostic_tools.cpp",
    "tools/ui_tools.cpp",
    "tools/animation_tools.cpp",
    "tools/material_tools.cpp",
    "tools/project_tools.cpp",
]
for src in tool_sources:
    module_obj.append(env_mcp_editor.Object(src))

# ---- 工具分派器 ----
module_obj.append(env_mcp_editor.Object("tool_dispatcher.cpp"))

# ---- 编辑器插件 ----
module_obj.append(env_mcp_editor.Object("editor_plugin.cpp"))

# 将模块对象注入 Godot 主构建
env.modules_sources += module_obj
